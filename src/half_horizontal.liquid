{% comment %}
  ============================================================================
  HALF_HORIZONTAL.LIQUID - Half-size Horizontal Banner (800x240)
  ============================================================================
  Framework: TRMNL Framework 3.4 (https://trmnl.com/framework/docs/3.4)
  Mashup Slot: Top or bottom half of a 1Tx1B stacked mashup
  Usable Content Height: ~144px (wide and shallow banner)

  View Adaptation Strategy (Section 15 of Template Guide):
  - Very wide (800px), very shallow (~144px height).
  - Columnize everything horizontally using `grid` with `col--span-{N}` or
    `grid--cols-{N}`. Avoid vertical stacking so content does not overflow.
  ============================================================================
{% endcomment %}

<div class="layout layout--row gap--medium">
  {% if has_data %}

  {% comment %}
    12-column proportional Grid split:
    - Left 5 columns: Hero metric
    - Right 7 columns: 3 side-by-side detail items
  {% endcomment %}
  <div class="grid gap--medium w--full">
    <div class="col--span-5 flex flex--col flex--center-y gap--xsmall">
      <span class="value value--large md:value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">
        {{ value | default: "42" }}
      </span>
      <span class="title title--small">
        {{ title | default: "Example Value" }}
      </span>
    </div>

    <div class="col--span-7 grid grid--cols-3 gap--small">
      {% render "metric_item", value: detail_1, label: "Metric 1" %}
      {% render "metric_item", value: detail_2, label: "Metric 2" %}
      {% render "metric_item", value: detail_3, label: "Metric 3" %}
    </div>
  </div>

  {% else %}
    {% render "error_state", size: "half_horizontal" %}
  {% endif %}
</div>

{% render "title_bar", icon: plugin_icon_data_uri, title: resolved_title, instance: resolved_instance %}
