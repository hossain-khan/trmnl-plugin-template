{% comment %}
  ============================================================================
  HALF_VERTICAL.LIQUID - Half-size Vertical Column (400x480)
  ============================================================================
  Framework: TRMNL Framework 3.4 (https://trmnl.com/framework/docs/3.4)
  Mashup Slot: Left or right half of a 1Lx1R side-by-side mashup
  Usable Content Height: ~368px (narrow 400px width, tall vertical column)

  View Adaptation Strategy (Section 15 of Template Guide):
  - Narrow width (400px), tall height (~368px).
  - Stack content vertically from top to bottom (`layout--col`).
  - Keep column counts low (`grid--cols-1` or `grid--cols-3` for compact numbers).
  ============================================================================
{% endcomment %}

<div class="layout layout--col gap--space-between">
  {% if has_data %}

  {% comment %} Primary content area - stacked vertically {% endcomment %}
  <div class="flex flex--col flex--center gap--xsmall stretch text--center">
    {% render "status_badge", status: status, message: status_label %}
    <span class="value value--xlarge md:value--xxlarge value--tnums" data-fit-value="true">
      {{ value | default: "42" }}
    </span>
    <span class="title title--small md:title--base">
      {{ title | default: "Example Value" }}
    </span>
    <span class="description" data-clamp="2">
      {{ status_description | default: "Everything is configured and running." }}
    </span>
  </div>

  <div class="divider"></div>

  {% comment %} Compact 3-column summary row at the bottom of the column {% endcomment %}
  <div class="grid grid--cols-3 gap--xsmall">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xsmall value--tnums">{{ detail_1 | default: "—" }}</span>
        <span class="label label--small">M1</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xsmall value--tnums">{{ detail_2 | default: "—" }}</span>
        <span class="label label--small">M2</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xsmall value--tnums">{{ detail_3 | default: "—" }}</span>
        <span class="label label--small">M3</span>
      </div>
    </div>
  </div>

  {% else %}
    {% render "error_state", size: "half_vertical" %}
  {% endif %}
</div>

{% render "title_bar", icon: plugin_icon_data_uri, title: resolved_title, instance: resolved_instance %}
