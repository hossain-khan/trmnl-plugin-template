{% comment %}
  ============================================================================
  QUADRANT.LIQUID - Quarter-size Postcard Layout (400x240)
  ============================================================================
  Framework: TRMNL Framework 3.4 (https://trmnl.com/framework/docs/3.4)
  Mashup Slot: One quarter of a 2x2 mashup (or cell in a 3x3 fluid mashup)
  Usable Content Height: ~144px (400px wide)

  View Adaptation Strategy (Section 15 of Template Guide):
  - Pick the ONE most important metric and display it clearly.
  - Ruthlessly cut secondary metrics, long descriptions, and legends.
  - Framework 3.4 automatically renders `.title_bar` in compact mode inside
    mashup views.
  ============================================================================
{% endcomment %}

<div class="layout layout--col layout--center gap--xsmall">
  {% if has_data %}

  <div class="flex flex--col flex--center gap--xsmall text--center">
    <span class="value value--large md:value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">
      {{ value | default: "42" }}
    </span>
    <span class="label" data-clamp="1">
      {{ title | default: "Quick Stats" }}
    </span>
  </div>

  {% else %}
    {% render "error_state", size: "quadrant" %}
  {% endif %}
</div>

{% render "title_bar", icon: plugin_icon_data_uri, title: resolved_title %}
