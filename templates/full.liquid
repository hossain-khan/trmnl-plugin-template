{% comment %}
  ============================================================================
  FULL.LIQUID - Full-screen Layout Template (800x480 OG / 1040x780 X)
  ============================================================================
  Framework: TRMNL Framework 3.4 (https://trmnl.com/framework/docs/3.4)
  Usable Content Height: ~320px (with title_bar)

  Best For:
  - Detailed dashboard displays with hero metrics + supporting items
  - Side-by-side Grid splits (e.g., 8/4 or 3-column metrics)
  - Full-screen tables, lists, or TRMNLCharts / TRMNLMaps visualizations

  Hard Rules Followed:
  - Do NOT wrap in `<div class="view">` (platform provides Screen and View)
  - `<div class="layout">` and `<div class="title_bar">` are siblings
  - Zero inline `style="..."` attributes and zero emojis (ePaper safe)
  ============================================================================
{% endcomment %}

<div class="layout layout--col gap--space-between">
  {% if has_data %}

  {% comment %} Top Hero Section: Primary Value + Status Badge {% endcomment %}
  <div class="flex flex--col flex--center gap--xsmall stretch text--center">
    {% render "status_badge", status: status, message: status_label %}
    <span class="value value--xxlarge md:value--xxxlarge lg:value--giga value--tnums" data-fit-value="true">
      {{ value | default: "42" }}
    </span>
    <span class="title title--base lg:title--large" data-clamp="1">
      {{ title | default: "Example Value" }}
    </span>
    {% if status_description %}
    <span class="description" data-clamp="2">
      {{ status_description }}
    </span>
    {% endif %}
  </div>

  {% if show_details != false and show_details != "false" %}
  {% comment %} Visual separator using Framework divider component {% endcomment %}
  <div class="divider"></div>

  {% comment %} Bottom Supporting Metrics using 3-Column Grid and `.item` pattern {% endcomment %}
  <div class="grid grid--cols-3 gap--medium">
    {% render "metric_item", value: detail_1, label: "Metric 1", index: "1" %}
    {% render "metric_item", value: detail_2, label: "Metric 2", index: "2" %}
    {% render "metric_item", value: detail_3, label: "Metric 3", index: "3" %}
  </div>
  {% endif %}

  {% else %}
    {% render "error_state", size: "full" %}
  {% endif %}
</div>

{% render "title_bar", icon: plugin_icon_data_uri, title: resolved_title, instance: resolved_instance %}
